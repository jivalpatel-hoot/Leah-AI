# Copy to .env and fill in. NEVER commit .env (it's gitignored).
# These power the brain & mouth adapters in packages/voice.

# --- Brain: Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Brain: GPT-4o Realtime (OpenAI) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# --- Brain + Mouth: Amazon Nova Sonic (Bedrock, HIPAA-eligible) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NOVA_SONIC_MODEL_ID=

# --- Mouth: voice platforms (only if brain != Nova Sonic) ---
VAPI_API_KEY=
VAPI_FROM_NUMBER_ID=
RETELL_API_KEY=
RETELL_AGENT_ID=
BLAND_API_KEY=
